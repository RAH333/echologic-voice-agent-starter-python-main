{
  "version": 2,
  "builds": [
    {
      "src": "deployment/browser/serverss.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/deployment/browser/serverss.py"
    },
    {
      "source": "/(.*)",
      "destination": "/deployment/browser/$1"
    }
  ]
}
